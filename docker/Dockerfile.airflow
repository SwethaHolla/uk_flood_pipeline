FROM apache/airflow:2.10.4-python3.12

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
USER airflow

COPY --chown=airflow:root pyproject.toml README.md LICENSE ./
COPY --chown=airflow:root src ./src

# Runtime deps for DAG tasks (ingestion + dbt + elementary).
# Installed system-wide so `python`/`dbt` on the airflow image PATH just work.
RUN pip install --no-cache-dir \
        "dlt[bigquery]>=1.5" \
        "pydantic>=2.9" \
        "httpx>=0.27" \
        "typer>=0.12" \
        "dbt-bigquery>=1.8" \
        "elementary-data[bigquery]>=0.13"

ENV PYTHONPATH=/opt/airflow/src
