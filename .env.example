# --- GCP / BigQuery ---
GCP_PROJECT_ID=ukfloodpipeline
BQ_LOCATION=europe-west2
BQ_RAW_DATASET=uk_flood_raw
BQ_DBT_SCHEMA=uk_flood
# Auth: prefer ADC (`gcloud auth application-default login`) or service-account
# impersonation. No downloaded key files. GOOGLE_APPLICATION_CREDENTIALS is kept
# for local-only testing but must never point at a committed key.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: impersonate this SA when using ADC (no key file).
GCP_IMPERSONATE_SA=dlt-runner@ukfloodpipeline.iam.gserviceaccount.com
# Safety cap: refuse any single query that would scan more than this many bytes
MAX_BYTES_BILLED=10737418240
# Project guardrails (informational):
#   BigQuery "Query usage per day" quota: 31,457 MiB = 30.72 GiB.
#   Quota day resets at midnight America/Los_Angeles: 07:00 London now,
#   08:00 London after 1 Nov. It is NOT midnight UTC.
#   On-demand price: $6.25/TiB, first 1 TiB/month free, 10 MB minimum/table+query
#   Monthly budget guardrail: GBP 5
BQ_DAILY_QUERY_QUOTA_MIB=31457
BQ_QUOTA_RESET_TZ=America/Los_Angeles

# --- EA Flood Monitoring API ---
EA_API_BASE_URL=https://environment.data.gov.uk/flood-monitoring
# Resilience knobs
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE=1.0

# --- dlt ---
DLT_DATASET_NAME=uk_flood_raw

# --- Elementary ---
ELEMENTARY_DATABASE=ukfloodpipeline
ELEMENTARY_SCHEMA=elementary

# --- Airflow (docker-compose) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
