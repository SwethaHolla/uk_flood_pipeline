# --- GCP / BigQuery ---
GCP_PROJECT_ID=ukfloodpipeline
BQ_LOCATION=US
BQ_RAW_DATASET=uk_flood_raw
BQ_DBT_SCHEMA=uk_flood
# Path to a GCP service-account JSON key (leave empty to use gcloud ADC)
GOOGLE_APPLICATION_CREDENTIALS=
# Safety cap: refuse any single query that would scan more than this many bytes
MAX_BYTES_BILLED=10737418240

# --- EA Flood Monitoring API ---
EA_API_BASE_URL=https://environment.data.gov.uk/flood-monitoring
# Resilience knobs
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE=1.0

# --- dlt ---
DLT_DATASET_NAME=uk_flood_raw

# --- Elementary ---
ELEMENTARY_DATABASE=ukfloodpipeline
ELEMENTARY_SCHEMA=elementary

# --- Airflow (docker-compose) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
